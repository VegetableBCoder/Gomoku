# 复制为 .env 并按需修改（.env 已被 gitignore，不会提交）。
# 不设也 OK：以上下文为准，相对路径都相对于项目根目录。

# 原始数据下载根目录（download_ms_dataset.py 的 --target）
GOBANG_DATA_ROOT=./data

# 原始 ModelScope 数据子集目录（preprocess_katago.py 的 --raw）
GOBANG_RAW_DIR=./data/fs15x_label28b

# 预处理后的训练数据目录（train.py 的 --data 默认值）
GOBANG_PROCESSED_DIR=./data/processed

# 训练输出目录
GOBANG_RUNS_DIR=./runs

# 模型存放目录
GOBANG_MODEL_DIR=./models
